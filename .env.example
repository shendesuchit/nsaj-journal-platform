# Local PostgreSQL connection for the FastAPI app and Alembic.
# Keep real credentials in the untracked .env file; never commit that file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nsaj_dev
DB_USER=nsaj_app
DB_PASSWORD=replace-with-your-local-password

# Local development uses email and password only. Production requires privileged MFA.
NSAJ_REQUIRE_PRIVILEGED_MFA=false
# Needed only if you explicitly enable privileged MFA in local development.
# NSAJ_MFA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
APP_ENV=development
PRIVATE_STORAGE_PATH=private_storage
MAIL_CAPTURE_PATH=.local/mail
PUBLIC_BASE_URL=http://localhost:3000
REVIEW_MODEL=single_anonymous
# New papers receive a stable reference such as NSAJ-48273106.
NSAJ_MANUSCRIPT_ID_PREFIX=NSAJ

# Outgoing mail: capture for development, smtp for real delivery.
MAIL_BACKEND=capture
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Required for SMTP in production: separate generated Fernet encryption key.
# MAIL_ENCRYPTION_KEY=

# Private submission inbox. Disabled until all required settings are supplied.
EMAIL_INTAKE_ENABLED=false
SUBMISSION_EMAIL=
JOURNAL_CONTACT_EMAIL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
MAX_INTAKE_MESSAGE_BYTES=20971520
EMAIL_INTAKE_LIFETIME_HOURS=72
CONTENT_SCHEDULER_ENABLED=true
