# ============================================================
# DO NOT IGNORE THESE IMPORTANT PROJECT FILES
# ============================================================

# The following are intentionally NOT ignored:
#
# README.md
# LICENSE
# .gitignore
# .env.example
# compose.yaml
# Dockerfile
# backend/pyproject.toml
# backend/alembic.ini
# backend/alembic/versions/
# frontend/package.json
# frontend/package-lock.json
# frontend/pnpm-lock.yaml
# frontend/yarn.lock
# docs/
# .github/workflows/
#
# Package-manager lock files should normally be committed
# to provide reproducible dependency installation.